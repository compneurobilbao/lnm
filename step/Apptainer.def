# Apptainer recipe for the step, built from the Docker image so both runtimes run the same bits:
#   apptainer build --build-arg IMAGE=lnm-tracts-step:dev step.sif step/Apptainer.def
# Production: apptainer build step.sif docker://<repository>@sha256:<digest>
Bootstrap: docker-daemon
From: {{ IMAGE }}

%post
    mkdir -p /in /out /ref /tmp
    chmod 0755 /in /out /ref
    chmod 1777 /tmp
    chmod -R a+rX /opt/step

%runscript
    exec /usr/local/bin/run "$@"

%test
    test -x /usr/local/bin/run
    test -r /opt/step/step.yaml
    command -v tckedit tckstats > /dev/null
    /usr/local/bin/run --help > /dev/null

%labels
    org.opencontainers.image.title lnm-tracts
    contract.version 1.0
